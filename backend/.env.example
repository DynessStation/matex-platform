NODE_ENV=production
PORT=9200
TRUST_PROXY=loopback
COOKIE_SECURE=true
JSON_BODY_LIMIT=1mb
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=600
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

DB_HOST=127.0.0.1
DB_USER=matexapp
DB_PASS=
DB_NAME=mia
DB_PORT=3306

JWT_SECRET=
JWT_EXPIRES_IN=1d
AUDIT_INTEGRITY_SECRET=

STORAGE_DISK=local
FILE_STORAGE_ROOT=/var/lib/matex/files
FILE_BASE_URL=https://matexindo.com/files
FILE_SERVE_LOCAL=true
BACKUP_ROOT=/var/backups/matex
BACKUP_RETENTION_DAYS=14

PUBLIC_COMPANY_ID=1
PUBLIC_SITE_URL=https://matexindo.com
CORS_ORIGINS=https://matexindo.com,https://www.matexindo.com,https://internal.matexindo.com

# First-party analytics stays off until the privacy notice/consent flow is ready.
PUBLIC_ANALYTICS_ENABLED=false
ANALYTICS_HASH_SECRET=
ANALYTICS_TRUST_COUNTRY_HEADER=false
ANALYTICS_COUNTRY_HEADER=cf-ipcountry

# Optional Google SEO integrations for the admin console.
# Add the service-account email as a user of the Search Console property.
GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:matexindo.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_PAGESPEED_API_KEY=

# Contact inquiry email notification. Use the Hostinger mailbox password.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@matexindo.com
SMTP_PASS=
SMTP_FROM_NAME=MATEX Website
SMTP_FROM_EMAIL=info@matexindo.com

# Optional content generation and Indonesian-to-English translation.
# Keep the key on the backend; never expose it in either Angular application.
OPENAI_API_KEY=
OPENAI_CONTENT_MODEL=gpt-4o-mini
